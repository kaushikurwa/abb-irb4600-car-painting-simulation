<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="painting_cell">
  <xacro:arg name="initial_positions_file" default="$(find painting_cell_moveit_config)/config/initial_positions.yaml"/>
  <xacro:include filename="$(find painting_cell_description)/urdf/cell.xacro"/>
  <xacro:include filename="painting_cell.ros2_control.xacro"/>
  <xacro:painting_cell_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>
</robot>
